{
  "name": "temporal-eager-workflow-start",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "build.watch": "tsc --build --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "ts-node src/run.ts",
    "start.watch": "nodemon src/run.ts",
    "test": "jest"
  },
  "nodemonConfig": {
    "execMap": {
      "ts": "ts-node"
    },
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/envconfig": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "nanoid": "3.x"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@temporalio/testing": "^1.25.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
