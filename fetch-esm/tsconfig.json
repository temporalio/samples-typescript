{
  "extends": "@tsconfig/node22/tsconfig.json",
  "version": "6.0.3",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2021"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
